# PUBLIC configuration only. Every VITE_* value is bundled into the browser: never put secrets here.
# live = real API responses (default); mock = simulated demo data, explicitly selected
VITE_DATA_MODE=live
# Empty in dev uses the Vite proxy. For deployed builds use an https origin (http allowed only for localhost).
VITE_API_BASE_URL=
# Dev proxy target (read by vite.config.ts at dev time; not bundled)
VITE_API_PROXY_TARGET=http://localhost:8000
