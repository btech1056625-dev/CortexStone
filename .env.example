POSTGRES_DB=cortexstone
POSTGRES_USER=cortexstone
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5433
API_PORT=8000
# ==========================================
# Cortexstone Environment Configuration
# Copy this file to .env and insert your real keys.
# DO NOT commit .env with real secrets to git!
# ==========================================

# Groq routing model
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ROUTER_MODEL_ID=llama-3.3-70b-versatile

# Google AI Studio reasoning model
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_REASONER_MODEL_ID=gemini-2.5-flash

# Optional: PostgreSQL / pgvector (Apurva)
DATABASE_URL=postgresql://cortexstone:local-dev-only@localhost:5433/cortexstone

# OIDC access-token validation. Leave all three blank to disable authenticated routes.
CORTEXSTONE_AUTH_ISSUER=
CORTEXSTONE_AUTH_AUDIENCE=
CORTEXSTONE_AUTH_JWKS_URL=
# Comma-separated verified OIDC subject IDs allowed to manage permission grants.
# Empty denies all grant/revoke administration.
CORTEXSTONE_PERMISSION_ADMIN_SUBJECTS=

# Exact browser dashboard origins, comma-separated (for example http://localhost:5173).
# Leave empty when the browser client is same-origin or not running.
CORTEXSTONE_CORS_ORIGINS=

# Optional: Telegram bot token (for morning briefs)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated exact notes.search targets (no wildcards, e.g. notes/personal).
# Empty registers no tools and fails closed.
CORTEXSTONE_POLICY_NOTES_SEARCH_TARGETS=
