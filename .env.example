POSTGRES_DB=cortexstone
POSTGRES_USER=cortexstone
POSTGRES_PASSWORD=local-dev-only
POSTGRES_PORT=5433
API_PORT=8000
# ==========================================
# Cortexstone Environment Configuration
# Copy this file to .env and insert your real keys.
# DO NOT commit .env with real secrets to git!
# ==========================================

# Nebius Token Factory (NVIDIA Open Models)
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_ROUTER_MODEL_ID=nvidia/nemotron-mini-4b-instruct
NEBIUS_REASONER_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# Optional: PostgreSQL / pgvector (Apurva)
DATABASE_URL=postgresql://cortexstone:local-dev-only@localhost:5433/cortexstone

# OIDC access-token validation. Leave all three blank to disable authenticated routes.
CORTEXSTONE_AUTH_ISSUER=
CORTEXSTONE_AUTH_AUDIENCE=
CORTEXSTONE_AUTH_JWKS_URL=

# Optional: Telegram bot token (for morning briefs)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated exact notes.search targets (no wildcards, e.g. notes/personal).
# Empty registers no tools and fails closed.
CORTEXSTONE_POLICY_NOTES_SEARCH_TARGETS=
